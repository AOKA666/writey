# Environment variable NAMES only. Do not put real secrets in this file or the repo.
# Copy to .dev.vars for local wrangler (gitignored) or set as Cloudflare Secrets.

# Cloudflare account and deploy (CLI; never commit values)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# D1
# D1_DATABASE_BINDING=DB
# D1_DATABASE_ID=

# Optional object storage (not required for client-side export MVP)
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Optional cookie signing for sessions. Random session IDs in D1 work without it;
# set this in production when you want HMAC-bound cookies.
# AUTH_SECRET=

# Payments are not open. Names reserved only; do not connect a live provider.
# PAYMENT_PROVIDER=
# PAYMENT_SECRET_KEY=
# PAYMENT_WEBHOOK_SECRET=

# Analytics provider is [待确认]. If unset, the client uses a documented no-op.
# ANALYTICS_MEASUREMENT_ID=
# VITE_ANALYTICS_MEASUREMENT_ID=

# Confirmed production origin only (https://, not a placeholder, writey.app,
# *.workers.dev, *.pages.dev, or localhost). If unset or unconfirmed, pages are
# noindex, canonical/og:url/sitemap locs are omitted, and robots.txt has no Sitemap line.
# Do not set this to a preview host to invent canonicals.
# SITE_URL=
# VITE_SITE_URL=
